{
  "name": "supergoop-sample-regressions",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test framework for supergoop.com (Shopify)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:core": "playwright test --grep @core",
    "test:core:p0": "playwright test --grep \"(?=.*@core)(?=.*@P0)\"",
    "test:regression": "playwright test --grep @regression",
    "test:staging": "playwright test --grep @staging",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --headed --project=desktop-chrome",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
