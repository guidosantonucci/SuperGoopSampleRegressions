# Target environment. Production is read-only for us: tests never press "Pay now" there.
BASE_URL=https://supergoop.com
# Set to "true" only against a staging/dev store using Shopify's Bogus Gateway
ALLOW_ORDER_PLACEMENT=false
# Storefront password for password-protected staging themes (optional)
STOREFRONT_PASSWORD=
# Block marketing/analytics pixels to cut noise and flakiness (recommended)
BLOCK_TRACKERS=true
# Seeded test account (staging only)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
