# Target environment. Production is read-only for us: tests never press "Pay now" there.
BASE_URL=https://supergoop.com
# Set to "true" only against a staging store using Shopify's Bogus Gateway
ALLOW_ORDER_PLACEMENT=false
# Storefront password for password-protected staging themes (optional)
STOREFRONT_PASSWORD=
# Block marketing/analytics pixels to cut noise and flakiness (recommended)
BLOCK_TRACKERS=true

# Seeded test account (staging only)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Shopify Admin API, staging custom app
# Scopes: read_orders, write_discounts, read_products, write_inventory, read_customers
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Transactional email checks (mailosaur.com)
MAILOSAUR_API_KEY=
MAILOSAUR_SERVER_ID=

# PayPal sandbox buyer (staging)
PAYPAL_SANDBOX_EMAIL=
PAYPAL_SANDBOX_PASSWORD=

# Skio customer portal path on the storefront
SUBSCRIPTION_PORTAL_PATH=/a/account
